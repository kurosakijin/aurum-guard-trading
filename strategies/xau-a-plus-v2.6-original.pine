//@version=6
strategy(
     "XAU A+ Strategy V2.6 BALANCED",
     overlay=true,
     pyramiding=0,
     initial_capital=10000,
     calc_on_every_tick=false,
     process_orders_on_close=true
)

// ============================================================================
// XAU A+ V2.6 BALANCED
// XAUUSD - 5 MINUTE
//
// LONG:
//   1H bullish
//   4H NOT strongly bearish
//
// SHORT:
//   1H bearish
//   4H NOT strongly bullish
//   AND (Daily bearish OR 4H strongly bearish)
//
// Confirmation:
//   Liquidity sweep
//   ADX / DMI
//   VWAP
//   BOS
//   Retest / rejection
//
// Risk:
//   A+    0.25%
//   A     0.15%
//   Retry 0.10%
// ============================================================================


// ============================================================================
// INPUTS
// ============================================================================

// DAILY
int dailyFastLen = input.int(50, "Daily Fast EMA", minval=10, group="1. Daily Regime")
int dailySlowLen = input.int(200, "Daily Slow EMA", minval=50, group="1. Daily Regime")

// 4H
string regimeTF = input.timeframe("240", "4H Regime", group="2. 4H Regime")
int regimeFastLen = input.int(50, "4H Fast EMA", minval=10, group="2. 4H Regime")
int regimeSlowLen = input.int(200, "4H Slow EMA", minval=50, group="2. 4H Regime")

// 1H
string biasTF = input.timeframe("60", "1H Bias", group="3. 1H Bias")
int biasFastLen = input.int(50, "1H Fast EMA", minval=10, group="3. 1H Bias")
int biasSlowLen = input.int(200, "1H Slow EMA", minval=50, group="3. 1H Bias")

float minimumEMASeparation = input.float(
     0.12,
     "Minimum EMA Separation / ATR",
     minval=0.0,
     maxval=3.0,
     step=0.01,
     group="3. 1H Bias"
)

// MOMENTUM
int dmiLength = input.int(14, "DMI Length", minval=5, group="4. Momentum")
int adxSmoothing = input.int(14, "ADX Smoothing", minval=5, group="4. Momentum")

float minimumADX = input.float(
     14.0,
     "Minimum ADX",
     minval=5.0,
     maxval=50.0,
     step=1.0,
     group="4. Momentum"
)

// LIQUIDITY
string setupTF = input.timeframe("15", "A+ Liquidity TF", group="5. Liquidity")

int setupSwingLookback = input.int(
     10,
     "15m Swing Lookback",
     minval=3,
     maxval=50,
     group="5. Liquidity"
)

int localSweepLookback = input.int(
     8,
     "5m Local Sweep Lookback",
     minval=3,
     maxval=30,
     group="5. Liquidity"
)

bool usePreviousDay = input.bool(true, "Previous Day H/L", group="5. Liquidity")
bool useAsia = input.bool(true, "Asian H/L", group="5. Liquidity")
bool use15mSwing = input.bool(true, "15m Swing Liquidity", group="5. Liquidity")
bool use5mSweep = input.bool(true, "5m Local Liquidity", group="5. Liquidity")

// ENTRY
int structureLookback = input.int(
     5,
     "Structure Lookback",
     minval=3,
     maxval=20,
     group="6. Entry"
)

int bosMaxBars = input.int(
     28,
     "Maximum Bars: Sweep -> BOS",
     minval=3,
     maxval=80,
     group="6. Entry"
)

int retestMaxBars = input.int(
     20,
     "Maximum Bars: BOS -> Retest",
     minval=2,
     maxval=60,
     group="6. Entry"
)

int atrLength = input.int(14, "ATR Length", minval=5, group="6. Entry")

float displacementATR = input.float(
     0.20,
     "Minimum Displacement / ATR",
     minval=0.05,
     maxval=2.0,
     step=0.05,
     group="6. Entry"
)

float retestToleranceATR = input.float(
     0.65,
     "Retest Tolerance / ATR",
     minval=0.10,
     maxval=2.0,
     step=0.05,
     group="6. Entry"
)

// RISK
float aPlusRisk = input.float(
     0.25,
     "A+ Risk %",
     minval=0.05,
     maxval=1.0,
     step=0.05,
     group="7. Risk"
)

float aRisk = input.float(
     0.15,
     "A Risk %",
     minval=0.05,
     maxval=1.0,
     step=0.05,
     group="7. Risk"
)

bool allowRetry = input.bool(
     true,
     "Allow One Re-entry",
     group="7. Risk"
)

float retryRisk = input.float(
     0.10,
     "Re-entry Risk %",
     minval=0.05,
     maxval=0.50,
     step=0.05,
     group="7. Risk"
)

int retryCooldownBars = input.int(
     8,
     "Re-entry Cooldown Bars",
     minval=1,
     maxval=100,
     group="7. Risk"
)

int retryExpiryBars = input.int(
     36,
     "Re-entry Expiry Bars",
     minval=5,
     maxval=200,
     group="7. Risk"
)

float stopBufferATR = input.float(
     0.35,
     "SL Buffer / ATR",
     minval=0.05,
     maxval=2.0,
     step=0.05,
     group="7. Risk"
)

float minStopATR = input.float(
     0.35,
     "Minimum Stop / ATR",
     minval=0.10,
     maxval=5.0,
     step=0.05,
     group="7. Risk"
)

float maxStopATR = input.float(
     4.00,
     "Maximum Stop / ATR",
     minval=1.0,
     maxval=10.0,
     step=0.25,
     group="7. Risk"
)

float tp1R = input.float(
     1.0,
     "TP1 R",
     minval=0.5,
     maxval=5.0,
     step=0.25,
     group="7. Risk"
)

float tp2R = input.float(
     2.0,
     "TP2 R",
     minval=1.0,
     maxval=10.0,
     step=0.25,
     group="7. Risk"
)

float tp1Percent = input.float(
     50.0,
     "TP1 Position %",
     minval=20.0,
     maxval=80.0,
     step=5.0,
     group="7. Risk"
)

float breakevenATR = input.float(
     0.05,
     "BE Profit Offset / ATR",
     minval=0.0,
     maxval=0.50,
     step=0.01,
     group="7. Risk"
)

float qtyStep = input.float(
     0.01,
     "Quantity Step",
     minval=0.001,
     step=0.001,
     group="7. Risk"
)

int maxTradesPerDay = input.int(
     3,
     "Maximum Entries / Day",
     minval=1,
     maxval=6,
     group="7. Risk"
)

// SESSIONS
string asiaSession = input.session(
     "0000-0600",
     "Asian Range",
     group="8. Sessions"
)

string asiaTimezone = input.string(
     "Etc/UTC",
     "Asian Timezone",
     group="8. Sessions"
)

bool tradeLondon = input.bool(true, "Trade London", group="8. Sessions")

string londonSession = input.session(
     "0600-1300",
     "London Window",
     group="8. Sessions"
)

bool tradeNY = input.bool(true, "Trade New York", group="8. Sessions")

string newYorkSession = input.session(
     "0700-1500",
     "New York Window",
     group="8. Sessions"
)

// DISPLAY
bool showDashboard = input.bool(true, "Dashboard", group="9. Display")
bool showVWAP = input.bool(true, "VWAP", group="9. Display")
bool showLiquidity = input.bool(true, "Liquidity Levels", group="9. Display")
bool showTradeLevels = input.bool(true, "Entry / SL / TP", group="9. Display")


// ============================================================================
// BASE DATA
// ============================================================================

float atr = ta.atr(atrLength)
float vwapValue = ta.vwap(hlc3)

bool correctTimeframe = timeframe.period == "5"

float recentStructureHigh = ta.highest(high, structureLookback)[1]
float recentStructureLow = ta.lowest(low, structureLookback)[1]

float localSwingHigh = ta.highest(high, localSweepLookback)[1]
float localSwingLow = ta.lowest(low, localSweepLookback)[1]

[plusDI, minusDI, adxValue] = ta.dmi(dmiLength, adxSmoothing)

bool bullishMomentum =
     adxValue >= minimumADX and
     plusDI > minusDI

bool bearishMomentum =
     adxValue >= minimumADX and
     minusDI > plusDI


// ============================================================================
// DAILY REGIME
// ============================================================================

float dailyClose = request.security(
     syminfo.tickerid,
     "D",
     close[1],
     lookahead=barmerge.lookahead_on
)

float dailyFast = request.security(
     syminfo.tickerid,
     "D",
     ta.ema(close, dailyFastLen)[1],
     lookahead=barmerge.lookahead_on
)

float dailyFastOld = request.security(
     syminfo.tickerid,
     "D",
     ta.ema(close, dailyFastLen)[2],
     lookahead=barmerge.lookahead_on
)

float dailySlow = request.security(
     syminfo.tickerid,
     "D",
     ta.ema(close, dailySlowLen)[1],
     lookahead=barmerge.lookahead_on
)

bool dailyBull =
     dailyClose > dailyFast and
     dailyFast >= dailyFastOld

bool dailyBear =
     dailyClose < dailyFast and
     dailyFast <= dailyFastOld

bool dailyDeepBear =
     dailyBear and
     dailyFast < dailySlow


// ============================================================================
// 4H REGIME
// ============================================================================

float regimeClose = request.security(
     syminfo.tickerid,
     regimeTF,
     close[1],
     lookahead=barmerge.lookahead_on
)

float regimeFast = request.security(
     syminfo.tickerid,
     regimeTF,
     ta.ema(close, regimeFastLen)[1],
     lookahead=barmerge.lookahead_on
)

float regimeFastOld = request.security(
     syminfo.tickerid,
     regimeTF,
     ta.ema(close, regimeFastLen)[2],
     lookahead=barmerge.lookahead_on
)

float regimeSlow = request.security(
     syminfo.tickerid,
     regimeTF,
     ta.ema(close, regimeSlowLen)[1],
     lookahead=barmerge.lookahead_on
)

bool strong4HBull =
     regimeClose > regimeSlow and
     regimeFast > regimeSlow and
     regimeFast > regimeFastOld

bool strong4HBear =
     regimeClose < regimeSlow and
     regimeFast < regimeSlow and
     regimeFast < regimeFastOld


// ============================================================================
// 1H BIAS
// ============================================================================

float biasClose = request.security(
     syminfo.tickerid,
     biasTF,
     close[1],
     lookahead=barmerge.lookahead_on
)

float biasFast = request.security(
     syminfo.tickerid,
     biasTF,
     ta.ema(close, biasFastLen)[1],
     lookahead=barmerge.lookahead_on
)

float biasFastOld = request.security(
     syminfo.tickerid,
     biasTF,
     ta.ema(close, biasFastLen)[2],
     lookahead=barmerge.lookahead_on
)

float biasSlow = request.security(
     syminfo.tickerid,
     biasTF,
     ta.ema(close, biasSlowLen)[1],
     lookahead=barmerge.lookahead_on
)

float biasATR = request.security(
     syminfo.tickerid,
     biasTF,
     ta.atr(14)[1],
     lookahead=barmerge.lookahead_on
)

float emaSeparation =
     biasATR > 0
     ? math.abs(biasFast - biasSlow) / biasATR
     : 0.0

bool separationOK =
     emaSeparation >= minimumEMASeparation

bool biasBull =
     biasClose > biasSlow and
     biasFast > biasSlow and
     biasFast >= biasFastOld and
     separationOK

bool biasBear =
     biasClose < biasSlow and
     biasFast < biasSlow and
     biasFast <= biasFastOld and
     separationOK


// ============================================================================
// V2.6 ASYMMETRIC PERMISSION
// ============================================================================

// BUY:
// 1H bullish.
// Only blocked if 4H is strongly bearish.
bool allowLong =
     biasBull and
     not strong4HBear

// SELL:
// 1H bearish mandatory.
// Strong 4H bullish blocks SELL.
// Either Daily bearish OR 4H strongly bearish supplies HTF confirmation.
bool allowShort =
     biasBear and
     not strong4HBull and
     (dailyBear or strong4HBear)


// ============================================================================
// PREVIOUS DAY HIGH / LOW
// ============================================================================

float previousDayHigh = request.security(
     syminfo.tickerid,
     "D",
     high[1],
     lookahead=barmerge.lookahead_on
)

float previousDayLow = request.security(
     syminfo.tickerid,
     "D",
     low[1],
     lookahead=barmerge.lookahead_on
)


// ============================================================================
// ASIAN RANGE
// ============================================================================

bool inAsia =
     not na(time(timeframe.period, asiaSession, asiaTimezone))

bool asiaStarted =
     inAsia and not inAsia[1]

var float asiaHigh = na
var float asiaLow = na

if asiaStarted
    asiaHigh := high
    asiaLow := low
else if inAsia
    asiaHigh := math.max(nz(asiaHigh, high), high)
    asiaLow := math.min(nz(asiaLow, low), low)


// ============================================================================
// TRADING WINDOW
// ============================================================================

bool londonWindow =
     tradeLondon and
     not na(time(timeframe.period, londonSession, "Europe/London"))

bool newYorkWindow =
     tradeNY and
     not na(time(timeframe.period, newYorkSession, "America/New_York"))

bool tradingWindow =
     londonWindow or newYorkWindow


// ============================================================================
// CONFIRMED 15m DATA
// ============================================================================

bool newSetupBar =
     ta.change(time(setupTF)) != 0

float setupHigh = request.security(
     syminfo.tickerid,
     setupTF,
     high[1],
     lookahead=barmerge.lookahead_on
)

float setupLow = request.security(
     syminfo.tickerid,
     setupTF,
     low[1],
     lookahead=barmerge.lookahead_on
)

float setupClose = request.security(
     syminfo.tickerid,
     setupTF,
     close[1],
     lookahead=barmerge.lookahead_on
)

float setupSwingHigh = request.security(
     syminfo.tickerid,
     setupTF,
     ta.highest(high, setupSwingLookback)[2],
     lookahead=barmerge.lookahead_on
)

float setupSwingLow = request.security(
     syminfo.tickerid,
     setupTF,
     ta.lowest(low, setupSwingLookback)[2],
     lookahead=barmerge.lookahead_on
)


// ============================================================================
// A+ LIQUIDITY
// ============================================================================

bool sweepPDL =
     usePreviousDay and
     setupLow < previousDayLow and
     setupClose > previousDayLow

bool sweepPDH =
     usePreviousDay and
     setupHigh > previousDayHigh and
     setupClose < previousDayHigh

bool sweepAsiaLow =
     useAsia and
     not na(asiaLow) and
     setupLow < asiaLow and
     setupClose > asiaLow

bool sweepAsiaHigh =
     useAsia and
     not na(asiaHigh) and
     setupHigh > asiaHigh and
     setupClose < asiaHigh

bool sweep15mLow =
     use15mSwing and
     not na(setupSwingLow) and
     setupLow < setupSwingLow and
     setupClose > setupSwingLow

bool sweep15mHigh =
     use15mSwing and
     not na(setupSwingHigh) and
     setupHigh > setupSwingHigh and
     setupClose < setupSwingHigh

bool bullAPlus =
     newSetupBar and
     allowLong and
     tradingWindow and
     (sweepPDL or sweepAsiaLow or sweep15mLow)

bool bearAPlus =
     newSetupBar and
     allowShort and
     tradingWindow and
     (sweepPDH or sweepAsiaHigh or sweep15mHigh)


// ============================================================================
// A-CLASS 5m LIQUIDITY
// ============================================================================

bool bullLocalSweep =
     use5mSweep and
     allowLong and
     tradingWindow and
     low < localSwingLow and
     close > localSwingLow

bool bearLocalSweep =
     use5mSweep and
     allowShort and
     tradingWindow and
     high > localSwingHigh and
     close < localSwingHigh

bool bullA =
     bullLocalSweep and
     not bullAPlus

bool bearA =
     bearLocalSweep and
     not bearAPlus


// ============================================================================
// CANDLE QUALITY
// ============================================================================

float candleRange =
     math.max(high - low, syminfo.mintick)

float candleBody =
     math.abs(close - open)

float upperWick =
     high - math.max(open, close)

float lowerWick =
     math.min(open, close) - low

float closeLocation =
     (close - low) / candleRange

bool bullishDisplacement =
     close > open and
     candleBody >= atr * displacementATR and
     closeLocation >= 0.58 and
     bullishMomentum

bool bearishDisplacement =
     close < open and
     candleBody >= atr * displacementATR and
     closeLocation <= 0.42 and
     bearishMomentum

bool bullishRejection =
     close > open and
     closeLocation >= 0.52 and
     (
         lowerWick >= candleBody * 0.15 or
         candleBody >= atr * 0.12
     )

bool bearishRejection =
     close < open and
     closeLocation <= 0.48 and
     (
         upperWick >= candleBody * 0.15 or
         candleBody >= atr * 0.12
     )


// ============================================================================
// SETUP STATE
// ============================================================================

var int longState = 0
var int shortState = 0

var int longSweepBar = na
var int shortSweepBar = na

var int longBOSBar = na
var int shortBOSBar = na

var float longSweepExtreme = na
var float shortSweepExtreme = na

var float longStructure = na
var float shortStructure = na

var float longBOSLevel = na
var float shortBOSLevel = na

var float pendingRisk = na

var string pendingClass = "NONE"
var string liquidityName = "WAIT"


// ============================================================================
// RETRY STATE
// ============================================================================

var bool retryEligible = false
var int retryDirection = 0
var int retryReadyBar = na
var int retryExpiryBar = na

if retryEligible and bar_index > retryExpiryBar
    retryEligible := false
    retryDirection := 0

if retryEligible and retryDirection == 1 and not allowLong
    retryEligible := false
    retryDirection := 0

if retryEligible and retryDirection == -1 and not allowShort
    retryEligible := false
    retryDirection := 0

bool longRetryBlocked =
     retryEligible and
     retryDirection == 1 and
     bar_index < retryReadyBar

bool shortRetryBlocked =
     retryEligible and
     retryDirection == -1 and
     bar_index < retryReadyBar


// ============================================================================
// REGISTER NEW SETUP
// ============================================================================

bool canRegister =
     strategy.position_size == 0 and
     longState == 0 and
     shortState == 0

if canRegister

    if bullAPlus and not longRetryBlocked

        longState := 1
        shortState := 0

        longSweepExtreme := setupLow
        longSweepBar := bar_index
        longStructure := recentStructureHigh

        pendingRisk := aPlusRisk
        pendingClass := "A+ LONG"

        if sweepPDL
            liquidityName := "PDL"
        else if sweepAsiaLow
            liquidityName := "ASIA LOW"
        else
            liquidityName := "15m SWING LOW"


    else if bearAPlus and not shortRetryBlocked

        shortState := 1
        longState := 0

        shortSweepExtreme := setupHigh
        shortSweepBar := bar_index
        shortStructure := recentStructureLow

        pendingRisk := aPlusRisk
        pendingClass := "A+ SHORT"

        if sweepPDH
            liquidityName := "PDH"
        else if sweepAsiaHigh
            liquidityName := "ASIA HIGH"
        else
            liquidityName := "15m SWING HIGH"


    else if bullA and not longRetryBlocked

        longState := 1
        shortState := 0

        longSweepExtreme := low
        longSweepBar := bar_index
        longStructure := recentStructureHigh

        pendingRisk := aRisk
        pendingClass := "A LONG"

        liquidityName := "5m SWING LOW"


    else if bearA and not shortRetryBlocked

        shortState := 1
        longState := 0

        shortSweepExtreme := high
        shortSweepBar := bar_index
        shortStructure := recentStructureLow

        pendingRisk := aRisk
        pendingClass := "A SHORT"

        liquidityName := "5m SWING HIGH"


// ============================================================================
// WAIT FOR LONG BOS
// ============================================================================

if longState == 1

    longSweepExtreme :=
         math.min(longSweepExtreme, low)

    bool expired =
         bar_index - longSweepBar > bosMaxBars

    if expired or not allowLong or not tradingWindow

        longState := 0

    else if close > longStructure and close > vwapValue and bullishDisplacement

        longBOSLevel := longStructure
        longBOSBar := bar_index
        longState := 2


// ============================================================================
// WAIT FOR SHORT BOS
// ============================================================================

if shortState == 1

    shortSweepExtreme :=
         math.max(shortSweepExtreme, high)

    bool expired =
         bar_index - shortSweepBar > bosMaxBars

    if expired or not allowShort or not tradingWindow

        shortState := 0

    else if close < shortStructure and close < vwapValue and bearishDisplacement

        shortBOSLevel := shortStructure
        shortBOSBar := bar_index
        shortState := 2


// ============================================================================
// DAILY LIMIT
// ============================================================================

bool newDay =
     ta.change(time("D")) != 0

var int tradesToday = 0

if newDay
    tradesToday := 0


// ============================================================================
// ACTIVE TRADE STATE
// ============================================================================

var int activeDirection = 0

var float activeEntry = na
var float activeStop = na
var float activeTP1 = na
var float activeTP2 = na
var float activeATR = na

var float activeTotalQty = na
var float activeTP1Qty = na
var float activeRunnerQty = na

var bool activeTP1Hit = false
var bool activeWasRetry = false

var string activeClass = "NONE"

var bool buySignal = false
var bool sellSignal = false

buySignal := false
sellSignal := false


// ============================================================================
// LONG ENTRY
// ============================================================================

if longState == 2 and strategy.position_size == 0 and correctTimeframe

    bool expired =
         bar_index - longBOSBar > retestMaxBars

    float tolerance =
         atr * retestToleranceATR

    bool retested =
         bar_index > longBOSBar and
         low <= longBOSLevel + tolerance and
         high >= longBOSLevel - tolerance

    bool validRetest =
         retested and
         close > longBOSLevel and
         close > vwapValue and
         allowLong and
         bullishMomentum and
         bullishRejection and
         tradingWindow

    if expired or not allowLong

        longState := 0

    else if validRetest and tradesToday < maxTradesPerDay

        bool isRetry =
             allowRetry and
             retryEligible and
             retryDirection == 1 and
             bar_index >= retryReadyBar and
             bar_index <= retryExpiryBar

        float riskPct =
             isRetry ? retryRisk : pendingRisk

        float entryPrice =
             close

        float stopPrice =
             longSweepExtreme - atr * stopBufferATR

        float stopDistance =
             entryPrice - stopPrice

        float stopDistanceATR =
             stopDistance / atr

        float cashRisk =
             strategy.equity * riskPct / 100.0

        float cashRiskPerUnit =
             stopDistance * syminfo.pointvalue

        float rawQty =
             cashRiskPerUnit > 0
             ? cashRisk / cashRiskPerUnit
             : na

        int totalSteps =
             not na(rawQty)
             ? int(math.floor(rawQty / qtyStep))
             : 0

        int tp1Steps =
             int(math.floor(totalSteps * tp1Percent / 100.0))

        int runnerSteps =
             totalSteps - tp1Steps

        float totalQty =
             totalSteps * qtyStep

        float firstQty =
             tp1Steps * qtyStep

        float runnerQty =
             runnerSteps * qtyStep

        bool validSize =
             stopDistance > 0 and
             stopDistanceATR >= minStopATR and
             stopDistanceATR <= maxStopATR and
             totalSteps >= 2 and
             tp1Steps >= 1 and
             runnerSteps >= 1

        if validSize

            float target1 =
                 entryPrice + stopDistance * tp1R

            float target2 =
                 entryPrice + stopDistance * tp2R

            activeDirection := 1

            activeEntry := entryPrice
            activeStop := stopPrice
            activeTP1 := target1
            activeTP2 := target2
            activeATR := atr

            activeTotalQty := totalQty
            activeTP1Qty := firstQty
            activeRunnerQty := runnerQty

            activeTP1Hit := false
            activeWasRetry := isRetry

            activeClass :=
                 isRetry
                 ? "RETRY LONG"
                 : pendingClass

            strategy.entry(
                 "LONG",
                 strategy.long,
                 qty=totalQty
            )

            strategy.exit(
                 "LONG TP1",
                 from_entry="LONG",
                 qty=firstQty,
                 stop=stopPrice,
                 limit=target1
            )

            strategy.exit(
                 "LONG RUNNER",
                 from_entry="LONG",
                 qty=runnerQty,
                 stop=stopPrice,
                 limit=target2
            )

            tradesToday += 1
            buySignal := true

            if isRetry
                retryEligible := false
                retryDirection := 0

            longState := 0
            shortState := 0


// ============================================================================
// SHORT ENTRY
// ============================================================================

if shortState == 2 and strategy.position_size == 0 and correctTimeframe

    bool expired =
         bar_index - shortBOSBar > retestMaxBars

    float tolerance =
         atr * retestToleranceATR

    bool retested =
         bar_index > shortBOSBar and
         high >= shortBOSLevel - tolerance and
         low <= shortBOSLevel + tolerance

    bool validRetest =
         retested and
         close < shortBOSLevel and
         close < vwapValue and
         allowShort and
         bearishMomentum and
         bearishRejection and
         tradingWindow

    if expired or not allowShort

        shortState := 0

    else if validRetest and tradesToday < maxTradesPerDay

        bool isRetry =
             allowRetry and
             retryEligible and
             retryDirection == -1 and
             bar_index >= retryReadyBar and
             bar_index <= retryExpiryBar

        float riskPct =
             isRetry ? retryRisk : pendingRisk

        float entryPrice =
             close

        float stopPrice =
             shortSweepExtreme + atr * stopBufferATR

        float stopDistance =
             stopPrice - entryPrice

        float stopDistanceATR =
             stopDistance / atr

        float cashRisk =
             strategy.equity * riskPct / 100.0

        float cashRiskPerUnit =
             stopDistance * syminfo.pointvalue

        float rawQty =
             cashRiskPerUnit > 0
             ? cashRisk / cashRiskPerUnit
             : na

        int totalSteps =
             not na(rawQty)
             ? int(math.floor(rawQty / qtyStep))
             : 0

        int tp1Steps =
             int(math.floor(totalSteps * tp1Percent / 100.0))

        int runnerSteps =
             totalSteps - tp1Steps

        float totalQty =
             totalSteps * qtyStep

        float firstQty =
             tp1Steps * qtyStep

        float runnerQty =
             runnerSteps * qtyStep

        bool validSize =
             stopDistance > 0 and
             stopDistanceATR >= minStopATR and
             stopDistanceATR <= maxStopATR and
             totalSteps >= 2 and
             tp1Steps >= 1 and
             runnerSteps >= 1

        if validSize

            float target1 =
                 entryPrice - stopDistance * tp1R

            float target2 =
                 entryPrice - stopDistance * tp2R

            activeDirection := -1

            activeEntry := entryPrice
            activeStop := stopPrice
            activeTP1 := target1
            activeTP2 := target2
            activeATR := atr

            activeTotalQty := totalQty
            activeTP1Qty := firstQty
            activeRunnerQty := runnerQty

            activeTP1Hit := false
            activeWasRetry := isRetry

            activeClass :=
                 isRetry
                 ? "RETRY SHORT"
                 : pendingClass

            strategy.entry(
                 "SHORT",
                 strategy.short,
                 qty=totalQty
            )

            strategy.exit(
                 "SHORT TP1",
                 from_entry="SHORT",
                 qty=firstQty,
                 stop=stopPrice,
                 limit=target1
            )

            strategy.exit(
                 "SHORT RUNNER",
                 from_entry="SHORT",
                 qty=runnerQty,
                 stop=stopPrice,
                 limit=target2
            )

            tradesToday += 1
            sellSignal := true

            if isRetry
                retryEligible := false
                retryDirection := 0

            shortState := 0
            longState := 0


// ============================================================================
// DETECT TP1
// ============================================================================

if activeDirection == 1 and strategy.position_size > 0 and not activeTP1Hit

    if math.abs(strategy.position_size) < activeTotalQty - qtyStep * 0.5
        activeTP1Hit := true


if activeDirection == -1 and strategy.position_size < 0 and not activeTP1Hit

    if math.abs(strategy.position_size) < activeTotalQty - qtyStep * 0.5
        activeTP1Hit := true


// ============================================================================
// RUNNER -> BREAKEVEN
// ============================================================================

if activeDirection == 1 and strategy.position_size > 0

    float runnerStop =
         activeTP1Hit
         ? activeEntry + activeATR * breakevenATR
         : activeStop

    strategy.exit(
         "LONG RUNNER",
         from_entry="LONG",
         qty=activeRunnerQty,
         stop=runnerStop,
         limit=activeTP2
    )


if activeDirection == -1 and strategy.position_size < 0

    float runnerStop =
         activeTP1Hit
         ? activeEntry - activeATR * breakevenATR
         : activeStop

    strategy.exit(
         "SHORT RUNNER",
         from_entry="SHORT",
         qty=activeRunnerQty,
         stop=runnerStop,
         limit=activeTP2
    )


// ============================================================================
// CLOSED POSITION / RETRY
// ============================================================================

bool positionJustClosed =
     strategy.position_size == 0 and
     strategy.position_size[1] != 0

if positionJustClosed

    bool reachedTP1 =
         activeTP1Hit

    if activeDirection == 1 and not na(activeTP1) and high >= activeTP1
        reachedTP1 := true

    if activeDirection == -1 and not na(activeTP1) and low <= activeTP1
        reachedTP1 := true


    if allowRetry and not reachedTP1 and not activeWasRetry

        retryEligible := true
        retryDirection := activeDirection
        retryReadyBar := bar_index + retryCooldownBars
        retryExpiryBar := bar_index + retryExpiryBars

    else

        retryEligible := false
        retryDirection := 0


    activeDirection := 0

    activeEntry := na
    activeStop := na
    activeTP1 := na
    activeTP2 := na
    activeATR := na

    activeTotalQty := na
    activeTP1Qty := na
    activeRunnerQty := na

    activeTP1Hit := false
    activeWasRetry := false
    activeClass := "NONE"


// ============================================================================
// PLOTS
// ============================================================================

plot(
     showVWAP ? vwapValue : na,
     "VWAP",
     color=color.orange,
     linewidth=2
)

plot(
     showLiquidity and usePreviousDay ? previousDayHigh : na,
     "PDH",
     color=color.new(color.red, 55),
     style=plot.style_linebr
)

plot(
     showLiquidity and usePreviousDay ? previousDayLow : na,
     "PDL",
     color=color.new(color.green, 55),
     style=plot.style_linebr
)

plot(
     showLiquidity and useAsia ? asiaHigh : na,
     "Asia High",
     color=color.new(color.red, 75),
     style=plot.style_linebr
)

plot(
     showLiquidity and useAsia ? asiaLow : na,
     "Asia Low",
     color=color.new(color.green, 75),
     style=plot.style_linebr
)

plot(
     showTradeLevels and strategy.position_size != 0 ? activeEntry : na,
     "Entry",
     color=color.white,
     linewidth=2,
     style=plot.style_linebr
)

plot(
     showTradeLevels and strategy.position_size != 0 ? activeStop : na,
     "SL",
     color=color.red,
     linewidth=2,
     style=plot.style_linebr
)

plot(
     showTradeLevels and strategy.position_size != 0 ? activeTP1 : na,
     "TP1",
     color=color.new(color.green, 25),
     linewidth=1,
     style=plot.style_linebr
)

plot(
     showTradeLevels and strategy.position_size != 0 ? activeTP2 : na,
     "TP2",
     color=color.green,
     linewidth=2,
     style=plot.style_linebr
)


// ============================================================================
// SETUP MARKERS
// ============================================================================

plotshape(
     bullAPlus,
     title="A+ Bull",
     text="A+",
     style=shape.circle,
     location=location.belowbar,
     color=color.green,
     textcolor=color.white,
     size=size.tiny
)

plotshape(
     bearAPlus,
     title="A+ Bear",
     text="A+",
     style=shape.circle,
     location=location.abovebar,
     color=color.red,
     textcolor=color.white,
     size=size.tiny
)

plotshape(
     bullA,
     title="A Bull",
     text="A",
     style=shape.circle,
     location=location.belowbar,
     color=color.new(color.green, 40),
     textcolor=color.white,
     size=size.tiny
)

plotshape(
     bearA,
     title="A Bear",
     text="A",
     style=shape.circle,
     location=location.abovebar,
     color=color.new(color.red, 40),
     textcolor=color.white,
     size=size.tiny
)


// ============================================================================
// REAL ENTRIES
// ============================================================================

plotshape(
     buySignal,
     title="BUY",
     text="BUY",
     style=shape.labelup,
     location=location.belowbar,
     color=color.green,
     textcolor=color.white,
     size=size.small
)

plotshape(
     sellSignal,
     title="SELL",
     text="SELL",
     style=shape.labeldown,
     location=location.abovebar,
     color=color.red,
     textcolor=color.white,
     size=size.small
)


// ============================================================================
// DASHBOARD
// ============================================================================

var table dashboard =
     table.new(position.top_right, 2, 14, border_width=1)

if barstate.islast and showDashboard

    string dailyText =
         dailyBull
         ? "BULL"
         : dailyBear
         ? "BEAR"
         : "NEUTRAL"

    string regimeText =
         strong4HBull
         ? "STRONG BULL"
         : strong4HBear
         ? "STRONG BEAR"
         : "NEUTRAL"

    string biasText =
         biasBull
         ? "BULL"
         : biasBear
         ? "BEAR"
         : "NEUTRAL"

    string setupText =
         longState == 1
         ? "LONG BOS"
         : shortState == 1
         ? "SHORT BOS"
         : longState == 2
         ? "LONG RETEST"
         : shortState == 2
         ? "SHORT RETEST"
         : "WAIT"

    string positionText =
         strategy.position_size > 0
         ? "LONG"
         : strategy.position_size < 0
         ? "SHORT"
         : "FLAT"

    string retryText =
         retryEligible
         ? retryDirection == 1
             ? "LONG"
             : "SHORT"
         : "NO"

    color dailyColor =
         dailyBull
         ? color.green
         : dailyBear
         ? color.red
         : color.gray

    color regimeColor =
         strong4HBull
         ? color.green
         : strong4HBear
         ? color.red
         : color.gray

    color biasColor =
         biasBull
         ? color.green
         : biasBear
         ? color.red
         : color.gray

    color adxColor =
         adxValue >= minimumADX
         ? color.green
         : color.red

    color sepColor =
         separationOK
         ? color.green
         : color.red


    table.cell(dashboard, 0, 0, "XAU V2.6")
    table.cell(
         dashboard,
         1,
         0,
         correctTimeframe ? "5m OK" : "USE 5m",
         text_color=correctTimeframe ? color.green : color.red
    )

    table.cell(dashboard, 0, 1, "Daily")
    table.cell(dashboard, 1, 1, dailyText, text_color=dailyColor)

    table.cell(dashboard, 0, 2, "4H")
    table.cell(dashboard, 1, 2, regimeText, text_color=regimeColor)

    table.cell(dashboard, 0, 3, "1H")
    table.cell(dashboard, 1, 3, biasText, text_color=biasColor)

    table.cell(dashboard, 0, 4, "BUY Allowed")
    table.cell(
         dashboard,
         1,
         4,
         allowLong ? "YES" : "NO",
         text_color=allowLong ? color.green : color.red
    )

    table.cell(dashboard, 0, 5, "SELL Allowed")
    table.cell(
         dashboard,
         1,
         5,
         allowShort ? "YES" : "NO",
         text_color=allowShort ? color.green : color.red
    )

    table.cell(dashboard, 0, 6, "ADX")
    table.cell(
         dashboard,
         1,
         6,
         str.tostring(adxValue, "#.0"),
         text_color=adxColor
    )

    table.cell(dashboard, 0, 7, "EMA Sep")
    table.cell(
         dashboard,
         1,
         7,
         str.tostring(emaSeparation, "#.00"),
         text_color=sepColor
    )

    table.cell(dashboard, 0, 8, "Momentum")
    table.cell(
         dashboard,
         1,
         8,
         bullishMomentum
         ? "BULL"
         : bearishMomentum
         ? "BEAR"
         : "WEAK"
    )

    table.cell(dashboard, 0, 9, "Liquidity")
    table.cell(dashboard, 1, 9, liquidityName)

    table.cell(dashboard, 0, 10, "Setup")
    table.cell(dashboard, 1, 10, setupText)

    table.cell(dashboard, 0, 11, "VWAP")
    table.cell(
         dashboard,
         1,
         11,
         close > vwapValue ? "ABOVE" : "BELOW"
    )

    table.cell(dashboard, 0, 12, "Position")
    table.cell(dashboard, 1, 12, positionText)

    table.cell(dashboard, 0, 13, "Re-entry")
    table.cell(dashboard, 1, 13, retryText)


// ============================================================================
// ALERTS
// ============================================================================

if buySignal
    alert(
         "XAU V2.6 BUY | " +
         activeClass +
         " | Entry " +
         str.tostring(activeEntry, format.mintick) +
         " | SL " +
         str.tostring(activeStop, format.mintick) +
         " | TP1 " +
         str.tostring(activeTP1, format.mintick) +
         " | TP2 " +
         str.tostring(activeTP2, format.mintick),
         alert.freq_once_per_bar_close
    )

if sellSignal
    alert(
         "XAU V2.6 SELL | " +
         activeClass +
         " | Entry " +
         str.tostring(activeEntry, format.mintick) +
         " | SL " +
         str.tostring(activeStop, format.mintick) +
         " | TP1 " +
         str.tostring(activeTP1, format.mintick) +
         " | TP2 " +
         str.tostring(activeTP2, format.mintick),
         alert.freq_once_per_bar_close
    )
