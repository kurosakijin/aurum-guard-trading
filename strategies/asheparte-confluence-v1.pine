// ============================================================================
// DASHBOARD
// ============================================================================

var table dashboard =
     table.new(position.top_right, 2, 14, border_width=1)

if barstate.islast and showDashboard

    string dailyText =
         dailyBull
         ? "BULL"
         : dailyBear
         ? "BEAR"
         : "NEUTRAL"

    string regimeText =
         strong4HBull
         ? "STRONG BULL"
         : strong4HBear
         ? "STRONG BEAR"
         : "NEUTRAL"

    string biasText =
         biasBull
         ? "BULL"
         : biasBear
         ? "BEAR"
         : "NEUTRAL"

    string setupText =
         longState == 1
         ? "LONG BOS"
         : shortState == 1
         ? "SHORT BOS"
         : longState == 2
         ? "LONG RETEST"
         : shortState == 2
         ? "SHORT RETEST"
         : "WAIT"

    string positionText =
         strategy.position_size > 0
         ? "LONG"
         : strategy.position_size < 0
         ? "SHORT"
         : "FLAT"

    string retryText =
         retryEligible
         ? retryDirection == 1
             ? "LONG"
             : "SHORT"
         : "NO"

    color dailyColor =
         dailyBull
         ? color.green
         : dailyBear
         ? color.red
         : color.gray

    color regimeColor =
         strong4HBull
         ? color.green
         : strong4HBear
         ? color.red
         : color.gray

    color biasColor =
         biasBull
         ? color.green
         : biasBear
         ? color.red
         : color.gray

    color adxColor =
         adxValue >= minimumADX
         ? color.green
         : color.red

    color sepColor =
         separationOK
         ? color.green
         : color.red


    table.cell(dashboard, 0, 0, "XAU V2.6")
    table.cell(
         dashboard,
         1,
         0,
         correctTimeframe ? "5m OK" : "USE 5m",
         text_color=correctTimeframe ? color.green : color.red
    )

    table.cell(dashboard, 0, 1, "Daily")
    table.cell(dashboard, 1, 1, dailyText, text_color=dailyColor)

    table.cell(dashboard, 0, 2, "4H")
    table.cell(dashboard, 1, 2, regimeText, text_color=regimeColor)

    table.cell(dashboard, 0, 3, "1H")
    table.cell(dashboard, 1, 3, biasText, text_color=biasColor)

    table.cell(dashboard, 0, 4, "BUY Allowed")
    table.cell(
         dashboard,
         1,
         4,
         allowLong ? "YES" : "NO",
         text_color=allowLong ? color.green : color.red
    )

    table.cell(dashboard, 0, 5, "SELL Allowed")
    table.cell(
         dashboard,
         1,
         5,
         allowShort ? "YES" : "NO",
         text_color=allowShort ? color.green : color.red
    )

    table.cell(dashboard, 0, 6, "ADX")
    table.cell(
         dashboard,
         1,
         6,
         str.tostring(adxValue, "#.0"),
         text_color=adxColor
    )

    table.cell(dashboard, 0, 7, "EMA Sep")
    table.cell(
         dashboard,
         1,
         7,
         str.tostring(emaSeparation, "#.00"),
         text_color=sepColor
    )

    table.cell(dashboard, 0, 8, "Momentum")
    table.cell(
         dashboard,
         1,
         8,
         bullishMomentum
         ? "BULL"
         : bearishMomentum
         ? "BEAR"
         : "WEAK"
    )

    table.cell(dashboard, 0, 9, "Liquidity")
    table.cell(dashboard, 1, 9, liquidityName)

    table.cell(dashboard, 0, 10, "Setup")
    table.cell(dashboard, 1, 10, setupText)

    table.cell(dashboard, 0, 11, "VWAP")
    table.cell(
         dashboard,
         1,
         11,
         close > vwapValue ? "ABOVE" : "BELOW"
    )

    table.cell(dashboard, 0, 12, "Position")
