         str.tostring(activeTP2, format.mintick),
         alert.freq_once_per_bar_close
    )


// ============================================================================
// PRICE ACTION COLOR FORECAST (ASHE) - DISPLAY ONLY
// Adapted from the supplied v5 indicator. Historical analogue, not a prediction.
// ============================================================================

bool pfEnabled = input.bool(true, "Show color forecast", group="Price action forecast")
int pfSeries = input.int(7, "Candle Series", minval=1, maxval=20, group="Price action forecast")
int pfForecast = input.int(100, "Forecast Candles", minval=1, maxval=166, group="Price action forecast")
bool pfDivider = input.bool(true, "Forecast Divider", group="Price action forecast")
bool pfDisplay = input.bool(true, "Display Event", group="Price action forecast")
color pfBull = input.color(#26a69a, "Bull candle", group="Price action forecast")
color pfBear = input.color(#ef5350, "Bear candle", group="Price action forecast")
var array<int> pfBars = array.new<int>()
var array<int> pfDirections = array.new<int>()
var array<float> pfOpens = array.new<float>()
var array<float> pfHighs = array.new<float>()
var array<float> pfLows = array.new<float>()
var array<float> pfCloses = array.new<float>()
var array<line> pfLines = array.new<line>()
var array<box> pfBoxes = array.new<box>()
var label pfLabel = na
var int pfLastStored = na

// Bounded closed-bar storage; no repeated live-bar snapshots.
if barstate.isconfirmed and (na(pfLastStored) or pfLastStored != bar_index)
    array.unshift(pfBars, bar_index)
    array.unshift(pfDirections, close > open ? 1 : close < open ? -1 : 0)
    array.unshift(pfOpens, open)
    array.unshift(pfHighs, high)
    array.unshift(pfLows, low)
    array.unshift(pfCloses, close)
    pfLastStored := bar_index
    if array.size(pfBars) > 3000
        array.pop(pfBars)
        array.pop(pfDirections)
        array.pop(pfOpens)
        array.pop(pfHighs)
        array.pop(pfLows)
        array.pop(pfCloses)

if barstate.islast or barstate.islastconfirmedhistory
    while array.size(pfLines) > 0
        line.delete(array.pop(pfLines))
    while array.size(pfBoxes) > 0
        box.delete(array.pop(pfBoxes))
    if not na(pfLabel)
        label.delete(pfLabel)
        pfLabel := na

    if pfEnabled
        int pfCount = array.size(pfBars)
        int pfMatch = na
        // The full historical continuation must finish before today's pattern.
        int pfFirstCandidate = pfForecast + pfSeries
        int pfLastCandidate = pfCount - pfSeries
        if pfFirstCandidate <= pfLastCandidate
            for candidate = pfFirstCandidate to pfLastCandidate
                bool equal = true
                for k = 0 to pfSeries - 1
                    if array.get(pfDirections, candidate + k) != array.get(pfDirections, k)
                        equal := false
                        break
                if equal
                    pfMatch := candidate
                    break

        if not na(pfMatch)
            int pfAnchor = array.get(pfBars, 0)
            float pfHistoricalClose = array.get(pfCloses, pfMatch)
            float pfScale = pfHistoricalClose != 0 ? array.get(pfCloses, 0) / pfHistoricalClose : na
            if not na(pfScale) and pfScale > 0
                float pfFutureHigh = array.get(pfCloses, 0)
                float pfFutureLow = pfFutureHigh
                for step = 1 to pfForecast
                    int sourceIndex = pfMatch - step
                    float projectedOpen = array.get(pfOpens, sourceIndex) * pfScale
                    float projectedClose = array.get(pfCloses, sourceIndex) * pfScale
                    float projectedHigh = array.get(pfHighs, sourceIndex) * pfScale
                    float projectedLow = array.get(pfLows, sourceIndex) * pfScale
                    int direction = array.get(pfDirections, sourceIndex)
                    color tint = color.new(direction == 1 ? pfBull : direction == -1 ? pfBear : chart.fg_color, 30)
                    int x = pfAnchor + step
                    // One projected candle per chart bar, not three-bar spacing.
                    array.push(pfLines, line.new(x, projectedLow, x, projectedHigh, color=tint))
                    float bodyTop = math.max(projectedOpen, projectedClose)
                    float bodyBottom = math.min(projectedOpen, projectedClose)
                    array.push(pfLines, line.new(x, bodyBottom, x, math.max(bodyTop, bodyBottom + syminfo.mintick), color=tint, width=5))
                    pfFutureHigh := math.max(pfFutureHigh, projectedHigh)
                    pfFutureLow := math.min(pfFutureLow, projectedLow)

                if pfDivider
                    array.push(pfLines, line.new(pfAnchor, pfFutureLow, pfAnchor, pfFutureHigh,
                         color=color.new(chart.fg_color, 50), style=line.style_dashed))
                if pfDisplay
                    float currentHigh = array.max(array.slice(pfHighs, 0, pfSeries))
                    float currentLow = array.min(array.slice(pfLows, 0, pfSeries))
                    float pastHigh = array.max(array.slice(pfHighs, pfMatch, pfMatch + pfSeries))
                    float pastLow = array.min(array.slice(pfLows, pfMatch, pfMatch + pfSeries))
                    float continuationHigh = array.max(array.slice(pfHighs, pfMatch - pfForecast, pfMatch))
                    float continuationLow = array.min(array.slice(pfLows, pfMatch - pfForecast, pfMatch))
                    array.push(pfBoxes, box.new(array.get(pfBars, pfSeries - 1), currentHigh, pfAnchor, currentLow,
                         border_color=chart.fg_color, border_style=line.style_dashed, bgcolor=color.new(chart.bg_color, 100)))
                    array.push(pfBoxes, box.new(array.get(pfBars, pfMatch + pfSeries - 1), pastHigh, array.get(pfBars, pfMatch), pastLow,
                         border_color=chart.fg_color, border_style=line.style_dashed, bgcolor=color.new(chart.bg_color, 100)))
                    array.push(pfBoxes, box.new(array.get(pfBars, pfMatch - 1), continuationHigh, array.get(pfBars, pfMatch - pfForecast), continuationLow,
                         border_color=chart.fg_color, border_style=line.style_dotted, bgcolor=color.new(color.teal, 85)))
                pfLabel := label.new(pfAnchor + pfForecast, pfFutureHigh,
                     "HISTORICAL COLOR MATCH · NOT A PREDICTION\n" + str.tostring(pfSeries) + "-candle pattern · " + str.tostring(pfForecast) + "-bar example",
                     style=label.style_label_down, color=color.new(chart.bg_color, 10), textcolor=chart.fg_color, size=size.small)
        else
            pfLabel := label.new(bar_index + 1, close,
                 "No complete historical color match\nTry fewer Candle Series / Forecast Candles",
                 style=label.style_label_left, color=color.new(chart.bg_color, 10), textcolor=chart.fg_color, size=size.small)

// ============================================================================
// MARKET STRUCTURE & ORDER BLOCKS - DISPLAY ONLY
// Adapted from the user-supplied "Market Structure Break & Order Block",
// short title "Jin Kurosaki". Swing origins are historical; recognition is later.
// ============================================================================

bool msbEnabled = input.bool(true, "Show structure and zones", group="Structure & order blocks")
int msbLength = input.int(9, "Zigzag length", minval=2, maxval=100, group="Structure & order blocks")
bool msbZigzag = input.bool(true, "Show confirmed zigzag", group="Structure & order blocks")
float msbFactor = input.float(0.273, "Break confirmation factor", minval=0, maxval=1, step=0.001, group="Structure & order blocks")
bool msbDeleteBroken = input.bool(true, "Delete broken zones", group="Structure & order blocks")
int msbZoneLimit = input.int(40, "Maximum active zones", minval=4, maxval=60, group="Structure & order blocks")
bool msbAlerts = input.bool(false, "Structure / zone alerts", group="Structure & order blocks")
color msbBullColor = input.color(color.teal, "Bullish color", group="Structure & order blocks")
color msbBearColor = input.color(color.orange, "Bearish color", group="Structure & order blocks")
string msbTextSize = input.string(size.tiny, "Zone text size", options=[size.tiny, size.small, size.normal], group="Structure & order blocks")

var array<float> msbHighs = array.new<float>()
var array<int> msbHighBars = array.new<int>()
var array<float> msbLows = array.new<float>()
var array<int> msbLowBars = array.new<int>()
var array<line> msbLines = array.new<line>()
var array<label> msbLabels = array.new<label>()
var array<box> msbZones = array.new<box>()
var array<int> msbZoneSides = array.new<int>()
var array<bool> msbInside = array.new<bool>()
var array<string> msbZoneNames = array.new<string>()
var array<box> msbArchived = array.new<box>()

msbPoint(array<float> prices, array<int> bars, int offset) =>
    int count = array.size(prices)
    [count > offset ? array.get(prices, count - 1 - offset) : float(na),
     count > offset ? array.get(bars, count - 1 - offset) : int(na)]

msbDrawLine(int x1, float y1, int x2, float y2, color tint, int thickness) =>
    if not na(x1) and not na(x2) and x1 >= bar_index - 4900 and x2 >= bar_index - 4900
        array.push(msbLines, line.new(x1, y1, x2, y2, color=tint, width=thickness))
        if array.size(msbLines) > 100
            line.delete(array.shift(msbLines))
    0

// Search only a valid, ordered interval within the last 500 candles.
// Return no zone when no qualifying candle exists (never reuse a stale candle).
msbFindCandle(int startBar, int endBar, bool bearishCandle) =>
    int result = na
    if not na(startBar) and not na(endBar) and startBar <= endBar and endBar <= bar_index
        int newest = math.max(0, bar_index - endBar)
        int oldest = math.min(500, math.min(bar_index, bar_index - startBar))
        if newest <= oldest
            for offset = newest to oldest
                if bearishCandle ? open[offset] > close[offset] : open[offset] < close[offset]
                    result := offset
                    break
    result

msbAddZone(int offset, int direction, string caption, color tint) =>
    if not na(offset)
        box zone = box.new(bar_index - offset, high[offset], bar_index + 10, low[offset],
             bgcolor=color.new(tint, 88), border_color=color.new(tint, 35),
             text=caption, text_color=chart.fg_color, text_halign=text.align_right, text_size=msbTextSize)
        array.push(msbZones, zone)
        array.push(msbZoneSides, direction)
        array.push(msbInside, false)
        array.push(msbZoneNames, caption)
        if array.size(msbZones) > msbZoneLimit
            box.delete(array.shift(msbZones))
            array.shift(msbZoneSides)
            array.shift(msbInside)
            array.shift(msbZoneNames)
    0

bool msbToUp = high >= ta.highest(high, msbLength)
bool msbToDown = low <= ta.lowest(low, msbLength)
int msbSinceUp = ta.barssince(msbToUp[1])
int msbSinceDown = ta.barssince(msbToDown[1])
int msbLowWindow = math.min(4900, math.max(1, nz(msbSinceUp, 1)))
int msbHighWindow = math.min(4900, math.max(1, nz(msbSinceDown, 1)))
float msbLow = ta.lowest(low, msbLowWindow)
float msbHigh = ta.highest(high, msbHighWindow)
int msbLowIndex = bar_index - ta.barssince(msbLow == low)
int msbHighIndex = bar_index - ta.barssince(msbHigh == high)
var int msbTrend = 1
int msbPreviousTrend = msbTrend
if barstate.isconfirmed
    msbTrend := msbTrend == 1 and msbToDown ? -1 : msbTrend == -1 and msbToUp ? 1 : msbTrend
bool msbSwingChanged = msbTrend != msbPreviousTrend

if msbSwingChanged
    if msbTrend == 1
        array.push(msbLows, msbLow)
        array.push(msbLowBars, msbLowIndex)
        if array.size(msbLows) > 5
            array.shift(msbLows)
            array.shift(msbLowBars)
    else
        array.push(msbHighs, msbHigh)
        array.push(msbHighBars, msbHighIndex)
        if array.size(msbHighs) > 5
            array.shift(msbHighs)
            array.shift(msbHighBars)

[msbH0, msbH0i] = msbPoint(msbHighs, msbHighBars, 0)
[msbH1, msbH1i] = msbPoint(msbHighs, msbHighBars, 1)
[msbL0, msbL0i] = msbPoint(msbLows, msbLowBars, 0)
[msbL1, msbL1i] = msbPoint(msbLows, msbLowBars, 1)

if msbEnabled and msbZigzag and msbSwingChanged
    msbDrawLine(msbH0i, msbH0, msbL0i, msbL0, color.new(chart.fg_color, 65), 1)

var int msbMarket = 1
var float msbLastLow = na
var float msbLastHigh = na
int msbPreviousMarket = msbMarket
bool msbReady = not na(msbH1) and not na(msbL1)
bool msbUsedSwing = (not na(msbLastLow) and msbLastLow == msbL0) or (not na(msbLastHigh) and msbLastHigh == msbH0)
if barstate.isconfirmed and msbReady and not msbUsedSwing
    msbMarket := msbMarket == 1 and msbL0 < msbL1 - math.abs(msbH0 - msbL1) * msbFactor ? -1 : msbMarket == -1 and msbH0 > msbH1 + math.abs(msbH1 - msbL0) * msbFactor ? 1 : msbMarket
bool msbBreak = msbMarket != msbPreviousMarket

if msbBreak
    msbLastLow := msbL0
    msbLastHigh := msbH0
    if msbEnabled
        color tint = msbMarket == 1 ? msbBullColor : msbBearColor
        float level = msbMarket == 1 ? msbH1 : msbL1
        int origin = msbMarket == 1 ? msbH1i : msbL1i
        msbDrawLine(origin, level, bar_index, level, tint, 2)
        // Label recognition now, not as a signal on a past swing candle.
        array.push(msbLabels, label.new(bar_index, level, msbMarket == 1 ? "Bull MSB" : "Bear MSB",
             color=color.new(tint, 85), textcolor=chart.fg_color,
             style=msbMarket == 1 ? label.style_label_down : label.style_label_up, size=size.small))
        if array.size(msbLabels) > 50
            label.delete(array.shift(msbLabels))
        if msbMarket == 1
            msbAddZone(msbFindCandle(msbH1i, msbL0i[msbLength], true), 1, "Bu-OB", tint)
            msbAddZone(msbFindCandle(msbL1i - msbLength, msbH1i, false), 1, msbL0 < msbL1 ? "Bu-BB" : "Bu-MB", tint)
        else
            msbAddZone(msbFindCandle(msbL1i, msbH0i[msbLength], false), -1, "Be-OB", tint)
            msbAddZone(msbFindCandle(msbH1i - msbLength, msbL1i, true), -1, msbH0 > msbH1 ? "Be-BB" : "Be-MB", tint)
        if msbAlerts
            alert(msbMarket == 1 ? "Bullish MSB confirmed (visual overlay)" : "Bearish MSB confirmed (visual overlay)", alert.freq_once_per_bar_close)

// Iterate backwards and remove the exact invalidated zone, not the first box.
if msbEnabled and barstate.isconfirmed and array.size(msbZones) > 0
    int zoneIndex = array.size(msbZones) - 1
    while zoneIndex >= 0
        box zone = array.get(msbZones, zoneIndex)
        int direction = array.get(msbZoneSides, zoneIndex)
        float top = box.get_top(zone)
        float bottom = box.get_bottom(zone)
        bool broken = direction == 1 ? close < bottom : close > top
        bool inside = close >= bottom and close <= top
        if broken
            box.set_right(zone, bar_index)
            if msbDeleteBroken
                box.delete(zone)
            else
                box.set_bgcolor(zone, color.new(chart.fg_color, 95))
                box.set_border_color(zone, color.new(chart.fg_color, 85))
                box.set_text(zone, array.get(msbZoneNames, zoneIndex) + " · broken")
                array.push(msbArchived, zone)
                if array.size(msbArchived) > 60
                    box.delete(array.shift(msbArchived))
            array.remove(msbZones, zoneIndex)
            array.remove(msbZoneSides, zoneIndex)
            array.remove(msbInside, zoneIndex)
            array.remove(msbZoneNames, zoneIndex)
        else
            box.set_right(zone, bar_index + 10)
            if msbAlerts and inside and not array.get(msbInside, zoneIndex)
                alert("Price entered " + array.get(msbZoneNames, zoneIndex) + " (visual overlay)", alert.freq_once_per_bar_close)
            array.set(msbInside, zoneIndex, inside)
        zoneIndex -= 1

// ============================================================================
// PARABOLIC SAR - INDEPENDENT VISUAL OVERLAY
// Adapted from the supplied Parabolic / PSAR indicator.
// PSAR reversals are not the strategy's trade signals or stop-loss orders.
// ============================================================================

bool psarEnabled = input.bool(true, "Show PSAR", group="PSAR · Calculation")
float psarStart = input.float(0.02, minval=0.001, step=0.001, title="Start", group="PSAR · Calculation")
float psarIncrement = input.float(0.02, minval=0.001, step=0.001, title="Increment", group="PSAR · Calculation")
float psarMaximum = input.float(0.2, minval=0.001, step=0.01, title="Maximum", group="PSAR · Calculation")
int psarWidth = input.int(2, minval=1, maxval=5, title="Point Width", group="PSAR · Visuals")
bool psarShowLabels = input.bool(true, "Show PSAR Buy/Sell Labels", group="PSAR · Visuals")
bool psarShowDots = input.bool(false, "Show PSAR dots", group="PSAR · Visuals")
bool psarHighlightStarts = input.bool(true, "Highlight Start Points", group="PSAR · Visuals")
bool psarHighlightState = input.bool(false, "Highlight State", group="PSAR · Visuals")
bool psarAlerts = input.bool(false, "PSAR reversal alerts", group="PSAR · Visuals")

float psarValue = ta.sar(psarStart, psarIncrement, psarMaximum)
int psarDirection = psarValue < close ? 1 : -1
color psarDotColor = psarDirection == 1 ? #3388bb : #fdcc02
psarDots = plot(psarEnabled ? psarValue : na, title="PSAR", style=plot.style_circles, linewidth=psarWidth, color=psarShowDots ? psarDotColor : na)

// Namespace prevents collisions with the strategy's buySignal/sellSignal.
// Confirm reversals only on closed bars; initial warm-up is not a reversal.
bool psarBuy = barstate.isconfirmed and not na(psarValue[1]) and psarDirection == 1 and psarDirection[1] == -1
bool psarSell = barstate.isconfirmed and not na(psarValue[1]) and psarDirection == -1 and psarDirection[1] == 1
plotshape(psarEnabled and psarBuy and psarHighlightStarts ? psarValue : na, title="PSAR Long Start",
     location=location.absolute, style=shape.circle, size=size.tiny, color=color.green)
plotshape(psarEnabled and psarBuy and psarShowLabels ? psarValue : na, title="PSAR Buy Label", text="PSAR Buy",
     location=location.absolute, style=shape.labelup, size=size.tiny, color=color.green, textcolor=color.white)
plotshape(psarEnabled and psarSell and psarHighlightStarts ? psarValue : na, title="PSAR Short Start",
     location=location.absolute, style=shape.circle, size=size.tiny, color=color.red)
plotshape(psarEnabled and psarSell and psarShowLabels ? psarValue : na, title="PSAR Sell Label", text="PSAR Sell",
     location=location.absolute, style=shape.labeldown, size=size.tiny, color=color.red, textcolor=color.white)

psarMiddle = plot(psarEnabled ? ohlc4 : na, title="PSAR midpoint", display=display.none, editable=false)
color psarFill = psarEnabled and psarHighlightState and not na(psarValue) ? (psarDirection == 1 ? color.new(color.green, 85) : color.new(color.red, 85)) : na
fill(psarMiddle, psarDots, title="PSAR Direction Shading", color=psarFill)

// alertcondition() does not provide selectable conditions in a strategy.
// Optional alert() events are separate from order-fill alerts; off by default.
if psarEnabled and psarAlerts and (psarBuy or psarSell)
    alert("PSAR " + (psarBuy ? "Buy" : "Sell") + " reversal · " + syminfo.tickerid + " · visual only, not a strategy entry", alert.freq_once_per_bar_close)

// Display-only moving average; does not change strategy filters or orders.
bool maVisible = input.bool(true, "Show moving average", group="Moving average")
int maLength = input.int(200, "Length", minval=1, maxval=5000, group="Moving average")
color maColor = input.color(color.white, "Color", group="Moving average")
float maValue = ta.sma(close, maLength)
plot(maVisible ? maValue : na, title="Moving Average (SMA)", color=maColor, linewidth=2)

// ============================================================================
// VOLUME FIGHT - COMMUNITY SCRIPT ADAPTATION
// Credit: "Volume fight", online community script supplied by the user.
// Original author, source URL and license were not provided; attribution unverified.
// English wording, Pine v6 compatibility and safety integration added here.
// Candle-derived volume estimate, not measured buyer/seller order-flow delta.
// Visual only: never changes the XAU strategy's orders or risk.
// ============================================================================

bool vfEnabled = input.bool(true, "Show Volume Fight", group="Volume Fight")
int vfLength = input.int(24, "Lookback bars", minval=1, maxval=500, group="Volume Fight",
     tooltip="Number of candles used to compare bullish and bearish volume estimates. A longer lookback smooths short-term changes but reacts more slowly.")
float vfFlatPercent = input.float(15.0, "Neutral-zone threshold (%)", minval=0, maxval=100, step=0.5, group="Volume Fight",
     tooltip="How much one volume estimate must dominate before a bullish or bearish zone is shown. Higher values create more neutral readings. Zero is most sensitive; 50% or more suppresses directional zones with this formula.")
bool vfBackground = input.bool(false, "Show background zones", group="Volume Fight",
     tooltip="Shade bullish zones green and bearish zones red. Neutral zones have no background.")
bool vfResetNeutral = input.bool(false, "Allow a new signal after a neutral zone", group="Volume Fight",
     tooltip="Off: another signal requires the opposite directional zone first. On: a neutral zone also resets the signal, allowing a fresh same-direction signal. This does not signal on every candle.")
bool vfAlerts = input.bool(false, "Volume Fight alerts", group="Volume Fight")

bool vfHasVolume = not na(volume) and volume > 0
float vfRange = high - low
// Flat candles split evenly instead of dividing by zero.
float vfBullVolume = vfHasVolume ? (close > open ? volume : vfRange > 0 ? volume * math.max(0.0, math.min(1.0, (high - open) / vfRange)) : volume * 0.5) : na
float vfBearVolume = vfHasVolume ? (open > close ? volume : vfRange > 0 ? volume * math.max(0.0, math.min(1.0, (open - low) / vfRange)) : volume * 0.5) : na
// Preserve the supplied VWMA weighting, even though its inputs already use volume.
float vfAverageBull = ta.vwma(vfBullVolume, vfLength)
float vfAverageBear = ta.vwma(vfBearVolume, vfLength)
float vfNormalized = vfHasVolume ? (vfAverageBull - vfAverageBear) / volume : na
float vfDifference = ta.sma(vfNormalized, vfLength)
float vfFlat = math.abs(vfAverageBull + vfAverageBear) / 2.0
// Require a complete valid window for both smoothing stages; no stale readings
// after zero/missing volume, even though moving averages can skip na samples.
float vfWindowValid = ta.lowest(vfHasVolume ? 1.0 : 0.0, 2 * vfLength - 1)
bool vfReady = bar_index >= 2 * vfLength - 2 and vfWindowValid == 1 and not na(vfDifference)
bool vfBull = vfReady and vfAverageBull > vfAverageBear and vfAverageBull > 0 and vfFlat / vfAverageBull < 1.0 - vfFlatPercent / 100.0
bool vfBear = vfReady and vfAverageBear > vfAverageBull and vfAverageBear > 0 and vfFlat / vfAverageBear < 1.0 - vfFlatPercent / 100.0

var int vfUp = 0
var int vfDown = 0
if barstate.isconfirmed
    if not vfReady
        vfUp := 0
        vfDown := 0
    else if vfBull
        vfUp += 1
        vfDown := 0
    else if vfBear
        vfDown += 1
        vfUp := 0
    else if vfResetNeutral
        vfUp := 0
        vfDown := 0

bool vfBuy = vfEnabled and barstate.isconfirmed and vfBull and vfUp == 1
bool vfSell = vfEnabled and barstate.isconfirmed and vfBear and vfDown == 1
color vfColor = vfBull ? color.green : vfBear ? color.red : color.new(color.gray, 50)

plotshape(vfBuy, title="Volume Fight UP", text="VF", location=location.belowbar, style=shape.triangleup, color=color.green, size=size.tiny)
plotshape(vfSell, title="Volume Fight DOWN", text="VF", location=location.abovebar, style=shape.triangledown, color=color.red, size=size.tiny)
bgcolor(vfEnabled and vfBackground and vfReady ? (vfBull ? color.new(color.green, 85) : vfBear ? color.new(color.red, 85) : na) : na, title="Volume Fight zones")
// Keep normalized volume off the price scale; use companion for the area graph.
plot(vfEnabled and vfReady ? vfDifference : na, title="Volume Fight difference (Data Window)", color=vfColor, display=display.data_window)
plot(vfEnabled ? (vfReady ? 1 : 0) : na, title="Volume Fight data ready (1=yes)", display=display.data_window)
if vfAlerts and (vfBuy or vfSell)
    alert("Volume Fight " + (vfBuy ? "UP · bullish volume estimate" : "DOWN · bearish volume estimate") + " · " + syminfo.tickerid + " · not a strategy entry", alert.freq_once_per_bar_close)
